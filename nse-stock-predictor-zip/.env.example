# --------------------------------------------------------------------------- #
# Frontend (Astro, PUBLIC_* vars are exposed to the browser)
# --------------------------------------------------------------------------- #
# Leave unset to use Astro's dev-server proxy (see astro.config.mjs) and
# same-origin "/api/..." requests to the FastAPI backend. Set this only if
# the frontend and the FastAPI backend are NOT served through the same
# proxy (e.g. a static build deployed separately from the API):
# PUBLIC_API_BASE_URL=http://localhost:8000

# --------------------------------------------------------------------------- #
# Backend (FastAPI / server.py, config.py)
# --------------------------------------------------------------------------- #
# CORS: comma-separated allowed origins, or "*" (default) for local/demo use.
# CORS_ORIGINS=http://localhost:3000

# API-key auth: leave unset/empty to keep the API open (default, back-compat
# with the original project). Set one or more comma-separated keys to
# require the X-API-Key header on every /api/* route (except /api/health).
# API_KEYS=changeme-dev-key,another-key-for-a-second-client
# API_KEY_HEADER_NAME=X-API-Key

# Rate limiting: in-memory, per API key (if auth is on) or per client IP.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Storage paths (all default to ./data/... next to server.py - override if
# you want the Parquet store / DuckDB file / cache on a different disk).
# DATA_DIR=./data
# DUCKDB_PATH=./data/nse.duckdb
# CACHE_DIR=./data/cache

# Cache TTLs (seconds).
# HISTORICAL_CACHE_TTL_SECONDS=21600   # 6h — closed daily bars rarely change
# LIVE_QUOTE_CACHE_TTL_SECONDS=60      # 1m — live quotes move constantly
# FORECAST_CACHE_TTL_SECONDS=900       # 15m — the model pipeline is expensive

# Parquet data is considered "fresh enough to serve without a re-fetch" if
# its last row is within this many calendar days (covers weekends/holidays).
# MAX_STALE_DAYS=3
