---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "NSE Pulse — Stock Prediction Terminal" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Live NSE OHLCV data, multi-model 5-day forecasts, and market-mood sentiment. Educational demo — not financial advice." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var saved = localStorage.getItem("nse-theme");
          var theme = saved || "dark";
          document.documentElement.classList.toggle("light", theme === "light");
          document.documentElement.classList.toggle("dark", theme !== "light");
        } catch (e) {
          /* localStorage unavailable — default dark stands */
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
